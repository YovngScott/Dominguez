{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/whatsapp-conectar", "destination": "/api/whatsapp-estado?action=conectar" },
    { "source": "/api/gmail-callback", "destination": "/api/procesar-seguro?action=insurance_oauth_callback" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/recordatorios-citas", "schedule": "0 13 * * *" },
    { "path": "/api/alerta-stock", "schedule": "30 12 * * *" },
    { "path": "/api/resumen-citas-semanal", "schedule": "*/15 * * * *" }
  ]
}
